<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ktpt.MusicSchool.Views.CourseView">
    <ScrollViewer>
        <StackPanel Spacing="15" MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock x:Name="NameText" FontSize="26" FontWeight="Bold"/>
            <Image x:Name="CourseImage" Height="200" HorizontalAlignment="Left" Stretch="Uniform"/>
            <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" FontSize="16"/>
            <TextBlock x:Name="PriceText" FontWeight="Bold" FontSize="18"/>
            
            <Separator Margin="0,10"/>
            
            <TextBlock Text="Выберите поток:" FontWeight="SemiBold"/>
            <ComboBox x:Name="VariantBox" MinWidth="400"/>
            
            <TextBlock Text="Количество мест:" FontWeight="SemiBold"/>
            <TextBox x:Name="QuantityBox" Text="1" Width="150" HorizontalAlignment="Left"/>
            
            <TextBlock Text="Дата занятия:" FontWeight="SemiBold"/>
            <CalendarDatePicker x:Name="DateBox" Width="200" HorizontalAlignment="Left"/>
            
            <StackPanel x:Name="ClientPanel" Spacing="5" IsVisible="False">
                <TextBlock Text="Клиент (для кого заказ):" FontWeight="SemiBold"/>
                <ComboBox x:Name="ClientBox" MinWidth="400"/>
            </StackPanel>

            <TextBlock Text="Заказ сохранится только после нажатия «Оформить»." Foreground="#666" Margin="0,10,0,0"/>
            
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="SaveButton" Content="Оформить" Classes="accent" Click="SaveClick" FontSize="18" Padding="20,10"/>
                <Button Content="Обновить данные" Click="ReloadClick" FontSize="18" Padding="20,10"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>