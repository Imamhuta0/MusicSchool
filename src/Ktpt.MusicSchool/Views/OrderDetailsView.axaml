<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ktpt.MusicSchool.Views.OrderDetailsView">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,15">
            <TextBlock x:Name="HeaderText" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="ClientText" FontSize="16"/>
            <TextBlock x:Name="DateText" FontSize="16"/>
            <TextBlock x:Name="TotalText" FontWeight="Bold" FontSize="18"/>
            
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                <Button x:Name="DeleteOrderBtn" Content="Удалить весь заказ" Click="DeleteOrderClick" Background="#FFCDD2" IsVisible="False"/>
                <Button Content="Обновить" Click="ReloadClick"/>
            </StackPanel>
            
            <Border x:Name="ConfirmPanel" IsVisible="False" Background="#FFCDD2" Padding="10" CornerRadius="5">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="ConfirmText" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Да, удалить" Click="ConfirmClick" Background="#C62828" Foreground="White"/>
                        <Button Content="Отмена" Click="CancelClick"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <TextBlock Text="Позиции заказа:" FontWeight="SemiBold" Margin="0,10,0,0"/>
        </StackPanel>
        <ListBox x:Name="ItemsList"/>
    </DockPanel>
</UserControl>