<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ktpt.MusicSchool.Views.LoginView">
    <StackPanel Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
        <TextBox x:Name="LoginBox" PlaceholderText="Логин" FontSize="18" Padding="10"/>
        <TextBox x:Name="PasswordBox" PlaceholderText="Пароль" PasswordChar="*" FontSize="18" Padding="10"/>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
            <Button Content="Войти" Classes="accent" Click="LoginClick" FontSize="18" Padding="20,10"/>
            <Button Content="Войти как гость" Click="GuestClick" Background="#D0D0D0" FontSize="18" Padding="20,10"/>
        </StackPanel>
    </StackPanel>
</UserControl>